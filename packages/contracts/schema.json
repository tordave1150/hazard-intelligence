{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazard.local/contracts/2.0",
  "$defs": {
    "Area": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "national",
            "region",
            "province",
            "district",
            "basin"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "name_th": {
          "type": "string",
          "minLength": 1
        },
        "region_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "province_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "geometry_ref": {
          "type": "string",
          "minLength": 1
        },
        "code_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "level",
        "parent_id",
        "name",
        "name_th",
        "region_id",
        "province_id",
        "lat",
        "lon",
        "bbox",
        "geometry_ref",
        "code_status"
      ],
      "additionalProperties": false
    },
    "Forecast": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "source_id": {
          "const": "open_meteo"
        },
        "data_state": {
          "const": "forecast"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "product_id": {
          "const": "daily_forecast"
        },
        "location_id": {
          "type": "string",
          "pattern": "^TH-(P-[0-9]{2}|D-[0-9]{4})$"
        },
        "forecast_reference_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "point": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "model_point": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "spatial_method": {
          "type": "string",
          "minLength": 1
        },
        "quality_status": {
          "enum": [
            "valid",
            "partial"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "units": {
          "type": "object",
          "properties": {
            "rainfall": {
              "const": "mm/24h"
            },
            "probability": {
              "const": "%"
            },
            "temperature": {
              "const": "°C"
            }
          },
          "required": [
            "rainfall",
            "probability",
            "temperature"
          ],
          "additionalProperties": false
        },
        "valid_periods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "valid_start": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\+00:00)$"
              },
              "valid_end": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\+00:00)$"
              },
              "rainfall_mm": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "rain_probability_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "temp_max_c": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "temp_min_c": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "date",
              "valid_start",
              "valid_end",
              "rainfall_mm",
              "rain_probability_pct",
              "temp_max_c",
              "temp_min_c"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "data_state",
        "ingested_at",
        "product_id",
        "location_id",
        "forecast_reference_time",
        "fetched_at",
        "point",
        "model_point",
        "spatial_method",
        "quality_status",
        "source_url",
        "units",
        "valid_periods"
      ],
      "additionalProperties": false
    },
    "WeatherObservation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "data_state": {
          "const": "observed"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "location_id": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "metric_type": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "quality_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "data_state",
        "ingested_at",
        "location_id",
        "point",
        "metric_type",
        "value",
        "unit",
        "observed_at",
        "fetched_at",
        "quality_status"
      ],
      "additionalProperties": false
    },
    "WaterGauge": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "data_state": {
          "const": "observed"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "gauge_id": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "metric_type": {
          "enum": [
            "river_level",
            "rainfall"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "station_datum": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold_definition": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "data_state",
        "ingested_at",
        "gauge_id",
        "point",
        "metric_type",
        "value",
        "unit",
        "observed_at",
        "fetched_at",
        "station_datum",
        "threshold_definition"
      ],
      "additionalProperties": false
    },
    "DamObservation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "source_id": {
          "const": "rid"
        },
        "data_state": {
          "const": "observed"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "product_id": {
          "const": "daily_dam_storage"
        },
        "dam_id": {
          "type": "string",
          "pattern": "^RID-DAM-[0-9]{6}$"
        },
        "source_dam_id": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "name_th": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        },
        "province_id": {
          "type": "string",
          "pattern": "^TH-P-[0-9]{2}$"
        },
        "district_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^TH-D-[0-9]{4}$"
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "source_region": {
          "type": "string",
          "minLength": 1
        },
        "normal_capacity_mcm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maximum_capacity_mcm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "storage_volume_mcm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "storage_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "observed_at": {
          "type": "null"
        },
        "time_precision": {
          "const": "date"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "quality_status": {
          "enum": [
            "valid",
            "partial"
          ]
        },
        "unit_metadata": {
          "type": "object",
          "properties": {
            "volume": {
              "const": "million m³"
            },
            "percentage": {
              "const": "% of normal storage capacity"
            }
          },
          "required": [
            "volume",
            "percentage"
          ],
          "additionalProperties": false
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "metadata_url": {
          "type": "string",
          "format": "uri"
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "data_state",
        "ingested_at",
        "product_id",
        "dam_id",
        "source_dam_id",
        "name_th",
        "owner",
        "point",
        "province_id",
        "district_id",
        "region_id",
        "source_region",
        "normal_capacity_mcm",
        "maximum_capacity_mcm",
        "storage_volume_mcm",
        "storage_pct",
        "report_date",
        "observed_at",
        "time_precision",
        "fetched_at",
        "quality_status",
        "unit_metadata",
        "source_url",
        "metadata_url",
        "license_url"
      ],
      "additionalProperties": false
    },
    "SatelliteFloodProduct": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "data_state": {
          "const": "satellite_observation"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "satellite": {
          "type": "string",
          "minLength": 1
        },
        "satellite_acquired_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "coverage_id": {
          "type": "string",
          "minLength": 1
        },
        "tile_or_layer_ref": {
          "type": "string",
          "format": "uri"
        },
        "processing_method": {
          "type": "string",
          "minLength": 1
        },
        "product_quality": {
          "type": "string",
          "minLength": 1
        },
        "license_metadata": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "data_state",
        "ingested_at",
        "product_id",
        "satellite",
        "satellite_acquired_at",
        "published_at",
        "fetched_at",
        "coverage_id",
        "tile_or_layer_ref",
        "processing_method",
        "product_quality",
        "license_metadata"
      ],
      "additionalProperties": false
    },
    "AgencyWarning": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "source_id": {
          "const": "tmd"
        },
        "data_state": {
          "const": "agency_warning"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "product_id": {
          "const": "cap_warnings"
        },
        "warning_id": {
          "type": "string",
          "minLength": 1
        },
        "sender": {
          "const": "TMD"
        },
        "message_type": {
          "enum": [
            "Alert",
            "Update",
            "Cancel"
          ]
        },
        "status": {
          "const": "Actual"
        },
        "scope": {
          "const": "Public"
        },
        "references": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "sender": {
                "type": "string",
                "minLength": 1
              },
              "warning_id": {
                "type": "string",
                "minLength": 1
              },
              "issued_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\+00:00)$"
              }
            },
            "required": [
              "sender",
              "warning_id",
              "issued_at"
            ],
            "additionalProperties": false
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "effective_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_time_source": {
          "enum": [
            "CAP effective",
            "CAP sent",
            "not supplied"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "headline": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "instruction": {
          "type": [
            "string",
            "null"
          ]
        },
        "agency_severity": {
          "enum": [
            "Extreme",
            "Severe",
            "Moderate",
            "Minor",
            "Unknown",
            null
          ]
        },
        "urgency": {
          "enum": [
            "Immediate",
            "Expected",
            "Future",
            "Past",
            "Unknown",
            null
          ]
        },
        "certainty": {
          "enum": [
            "Observed",
            "Likely",
            "Possible",
            "Unlikely",
            "Unknown",
            null
          ]
        },
        "area_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 77,
          "items": {
            "type": "string",
            "pattern": "^TH-P-[0-9]{2}$"
          }
        },
        "source_areas": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "geocodes": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "value_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "value_name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "description",
              "geocodes"
            ],
            "additionalProperties": false
          }
        },
        "geometry": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "MultiPolygon"
                },
                "coordinates": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 20000,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            }
          ]
        },
        "content_ref": {
          "type": "string",
          "format": "uri"
        },
        "source_url": {
          "const": "https://www.tmd.go.th/api/xml/CAP"
        },
        "terms_url": {
          "const": "https://www.tmd.go.th/content/copyright"
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "data_state",
        "ingested_at",
        "product_id",
        "warning_id",
        "sender",
        "message_type",
        "status",
        "scope",
        "references",
        "issued_at",
        "fetched_at",
        "effective_start",
        "expires_at",
        "effective_time_source",
        "language",
        "event",
        "headline",
        "description",
        "instruction",
        "agency_severity",
        "urgency",
        "certainty",
        "area_ids",
        "source_areas",
        "geometry",
        "content_ref",
        "source_url",
        "terms_url"
      ],
      "additionalProperties": false
    },
    "WarningFeed": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "source_id": {
          "const": "tmd"
        },
        "data_state": {
          "const": "agency_warning"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "product_id": {
          "const": "cap_warnings"
        },
        "snapshot_id": {
          "const": "latest"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "feed_generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "feed_url": {
          "const": "https://www.tmd.go.th/api/xml/CAP"
        },
        "feed_copyright": {
          "const": "public domain"
        },
        "feed_item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "ignored_item_count": {
