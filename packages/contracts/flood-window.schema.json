{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazard-intelligence.local/contracts/flood-window",
  "$ref": "#/$defs/Metadata",
  "$defs": {
    "Metadata": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "3.0"
        },
        "source_id": {
          "const": "gistda"
        },
        "data_state": {
          "const": "satellite_observation"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "product_id": {
          "enum": [
            "flood_3days_thailand",
            "flood_7days_thailand",
            "flood_30days_thailand"
          ]
        },
        "snapshot_id": {
          "const": "latest"
        },
        "product_window": {
          "enum": [
            "3days",
            "7days",
            "30days"
          ]
        },
        "area_id": {
          "const": "TH"
        },
        "query": {
          "type": "object",
          "properties": {
            "limit": {
              "const": 1000,
              "description": "Initial maximum page request limit. Optional page_limits lists each accepted page request limit."
            },
            "offset": {
              "const": 0
            }
          },
          "required": [
            "limit",
            "offset"
          ],
          "additionalProperties": false
        },
        "source_url": {
          "enum": [
            "https://api-gateway.gistda.or.th/api/2.0/resources/features/flood/3days",
            "https://api-gateway.gistda.or.th/api/2.0/resources/features/flood/7days",
            "https://api-gateway.gistda.or.th/api/2.0/resources/features/flood/30days"
          ]
        },
        "attribution": {
          "const": "GISTDA Disaster Platform"
        },
        "response_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "observed_at": {
          "type": "null"
        },
        "observation_time_status": {
          "const": "NOT_SUPPLIED"
        },
        "complete_provider_query": {
          "const": true
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250000
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "area_metrics": {
          "const": "NOT_USED_UNITS_UNVERIFIED"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "pagination_consistency": {
          "const": "COUNT_AND_DUPLICATES_CHECKED_NO_VERSION_TOKEN"
        },
        "page_limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "items": {
            "enum": [
              1000,
              500,
              250,
              125,
              100
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "data_state",
        "ingested_at",
        "product_id",
        "snapshot_id",
        "product_window",
        "area_id",
        "query",
        "source_url",
        "attribution",
        "response_at",
        "fetched_at",
        "observed_at",
        "observation_time_status",
        "complete_provider_query",
        "record_count",
        "coverage",
        "area_metrics",
        "interpretation",
        "page_count",
        "pagination_consistency"
      ],
      "additionalProperties": false
    },
    "Feature": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "geometry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 20000,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "MultiPolygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 20000,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 3,
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            }
          ]
        },
        "properties": {
          "type": "null"
        },
        "area_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^TH-P-[0-9]{2}$"
            },
            {
              "type": "string",
              "pattern": "^TH-D-[0-9]{4}$"
            }
          ],
          "items": false
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties",
        "area_ids"
      ],
      "additionalProperties": false
    },
    "ChunkPayload": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/Feature"
      }
    }
  }
}
