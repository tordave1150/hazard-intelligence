# For CLI ingestion: set these in your shell / approved secrets manager.
# The Python runner deliberately does not auto-load local .env files.
MONGODB_URI=
MONGODB_DB_NAME=weather_db
# Optional commercial Open-Meteo API key. Never expose through NEXT_PUBLIC_.
OPEN_METEO_API_KEY=

# Production radar publication uses connector-managed BLOB_READ_WRITE_TOKEN.
# Local --export radar preview requires no Blob credentials. Never use NEXT_PUBLIC_ for tokens.
